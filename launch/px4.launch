<?xml version="1.0"?>
<launch>
    <!-- Wheel Loader SITL launch script -->
    <!-- Launches wheel loader control system. This can be used by external projects -->

    <!-- Wheel Loader config arguments -->
    <arg name="est" default="ekf2"/>
    <arg name="vehicle" default="wheel_loader"/>
    <arg name="ID" default="0"/>
    <arg name="interactive" default="true"/>

    <env name="PX4_SIM_MODEL" value="gazebo-classic_$(arg vehicle)" />
    <arg unless="$(arg interactive)" name="px4_command_arg1" value="-d"/>
    <arg     if="$(arg interactive)" name="px4_command_arg1" value=""/>
    <node name="sitl_$(arg ID)" pkg="wheel_loader" type="px4" output="screen" args="$(find wheel_loader)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i $(arg ID) $(arg px4_command_arg1)">
    </node>
</launch>
