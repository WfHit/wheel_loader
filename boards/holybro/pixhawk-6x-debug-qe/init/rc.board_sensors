#!/bin/sh
#
# Board specific sensors init for Pixhawk 6X Debug QE
#

board_adc start

# Internal SPI bus ICM-20649
icm20649 -s -R 6 start

# Internal SPI bus ICM-42688p
icm42688p -s -R 4 start

# Internal SPI bus BMI088 accel/gyro
bmi088 -A -s -R 2 start
bmi088 -G -s -R 2 start

# Internal SPI bus ICP201xx
icp201xx -s -R 6 start

# Internal magnetometer on I2C
bmm150 -I start

# External compass on GPS1/I2C1 (the 3rd external bus): standard Holybro Pixhawk 4 or CUAV V5 GPS/compass puck (with lights, safety button, and buzzer)
ist8310 -I -b 1 start

# Possible external compass on I2C2
ist8310 -I -b 2 start

# Possible external compass on I2C4
ist8310 -I -b 4 start

# Start quadrature encoder driver
if quad_encoder start -i 0 -d /dev/qe0
then
	echo "Quadrature encoder started on I2C3 pins"
else
	echo "Failed to start quadrature encoder"
fi
